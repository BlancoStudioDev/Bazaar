<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>it.blancostudio.bazaar-fb</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>@REPO@/deploy/fb-tunnel.sh</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>@HOME@/Library/Logs/bazaar-fb-tunnel.log</string>
  <key>StandardErrorPath</key><string>@HOME@/Library/Logs/bazaar-fb-tunnel.log</string>
</dict>
</plist>
