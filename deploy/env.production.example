# Copia sul server come $DEPLOY_PATH/.env.production (chmod 600). SOLO placeholder: nessun segreto nel repo.

NODE_ENV=production
PORT=3210
# L'app vive sotto https://blancostudio.dev/bazaar (niente sottodominio)
APP_BASE_PATH=/bazaar

# --- Autenticazione (Better Auth + OIDC onionrings) ---
# SOLO l'origine pubblica (https, senza /bazaar e senza slash finale).
BETTER_AUTH_URL=https://blancostudio.dev
# Genera con: openssl rand -base64 32
BETTER_AUTH_SECRET=CAMBIAMI
# Issuer OIDC e credenziali del client registrato su https://auth.onionrings.dev/admin/
ONIONRINGS_ISSUER=https://auth.onionrings.dev/api/auth
ONIONRINGS_CLIENT_ID=CAMBIAMI
ONIONRINGS_CLIENT_SECRET=CAMBIAMI
# Email autorizzate, separate da virgola
ALLOWED_EMAILS=tu@example.com
# Database SQLite dell'auth: cartella persistente, scrivibile dal servizio
AUTH_DB_PATH=/home/blanco05/bazaar/data/auth.db

# --- LLM: basta UNA chiave ---
OPENROUTER_API_KEY=sk-or-v1-CAMBIAMI
OPENROUTER_APP_URL=https://blancostudio.dev/bazaar
OPENROUTER_APP_NAME=Bazaar
# Riserva a pagamento: lasciala false in produzione multiutente (costi a carico tuo)
OPENROUTER_ALLOW_PAID_FALLBACK=false
# Provider free diretti opzionali
# GROQ_API_KEY=
# CEREBRAS_API_KEY=
# GEMINI_API_KEY=
# MISTRAL_API_KEY=

# --- Limiti per utente / globali ---
CHAT_RATE_PER_HOUR=30
CHAT_MAX_CONCURRENT_PER_USER=2
CHAT_MAX_CONCURRENT_GLOBAL=6

# --- Server MCP (percorsi sul server; DEPLOY_PATH = /home/blanco05/bazaar) ---
MCP_ROOT=/home/blanco05/bazaar/mcp
MCP_PYTHON_SHARED=/home/blanco05/bazaar/mcp/.venv/bin/python
MCP_PYTHON_SUBITO=/home/blanco05/bazaar/mcp/subito-search/.venv/bin/python
MCP_PYTHON_FACEBOOK=/home/blanco05/bazaar/mcp/facebook-marketplace/.venv/bin/python
# Facebook legge i cookie dal profilo Chrome del Mac: sul server va disabilitato
# (vedi deploy/README.md per l'alternativa con cookie manuali).
MCP_DISABLED=facebook-marketplace
# MCP_TOOL_TIMEOUT_MS=20000
