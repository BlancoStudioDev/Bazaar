# Copia questo file in .env.local. Basta UNA chiave LLM qualsiasi (tutte con free tier, costo 0).
# Ordine di prova: provider diretti con chiave -> modelli OpenRouter free -> router free -> (opt-in) riserva a pagamento.

# Provider free diretti (OpenAI-compatibili). Attivi solo se la chiave è presente.
# Groq:     https://console.groq.com/keys
# GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b
# Cerebras: https://cloud.cerebras.ai/
# CEREBRAS_API_KEY=
# CEREBRAS_MODEL=gpt-oss-120b
# Gemini:   https://aistudio.google.com/apikey
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-latest
# Mistral:  https://console.mistral.ai/api-keys
# MISTRAL_API_KEY=
# MISTRAL_MODEL=mistral-small-latest

# OpenRouter (opzionale se hai almeno un altro provider): https://openrouter.ai/keys
# OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_APP_URL=http://localhost:3000
OPENROUTER_APP_NAME=Bazaar

# Riserva a pagamento: DISATTIVATA di default (richiede OPENROUTER_API_KEY e crediti).
# Anche con true, serve il toggle nelle impostazioni. Ordine: free -> tier economico -> riserva fissa.
OPENROUTER_ALLOW_PAID_FALLBACK=false
# Tier economico (lista di id separati da virgola). Default: i 3 modelli a pagamento con tool support
# più economici (gpt-oss, qwen, deepseek, gemini flash, llama, glm...) scelti dal catalogo OpenRouter.
# OPENROUTER_CHEAP_MODELS=openai/gpt-oss-120b,qwen/qwen3.7-flash
# OPENROUTER_PAID_FALLBACK_MODEL=deepseek/deepseek-v4.1-flash

# Server MCP locali (default: ~/.config/opencode/mcp).
# MCP_ROOT=/Users/tu/.config/opencode/mcp
# MCP_PYTHON_SHARED=/Users/tu/.config/opencode/mcp/.venv/bin/python
# MCP_PYTHON_SUBITO=/Users/tu/.config/opencode/mcp/subito-search/.venv/bin/python
# MCP_PYTHON_FACEBOOK=/Users/tu/.config/opencode/mcp/facebook-marketplace/.venv/bin/python
# MCP_DISABLED=aliexpress

# --- Multiutente / produzione (vedi deploy/env.production.example e deploy/README.md) ---
# BETTER_AUTH_URL=http://localhost:3000
# BETTER_AUTH_SECRET=          # openssl rand -base64 32
# ONIONRINGS_ISSUER=https://auth.onionrings.dev
# ONIONRINGS_CLIENT_ID=
# ONIONRINGS_CLIENT_SECRET=
# ALLOWED_EMAILS=tu@example.com
# AUTH_DB_PATH=./data/auth.db
# CHAT_RATE_PER_HOUR=30
# CHAT_MAX_CONCURRENT_PER_USER=2
# CHAT_MAX_CONCURRENT_GLOBAL=6
